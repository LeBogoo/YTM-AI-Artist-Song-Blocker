{
  "manifest_version": 3,
  "name": "YTM AI Artist & Song Blocker",
  "version": "1.5",
  "description": "Block specific artists and keywords on YouTube Music. Automatically Take control over AI slop with the Zoundhub AI artist database",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://zoundhub.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manage Block List"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  }
}